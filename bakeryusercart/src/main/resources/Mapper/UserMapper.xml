<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="demo.usercart.mapper.UserMapper">


	<!-- 依 username 查詢會員 -->
	<select id="findByUsername" parameterType="java.lang.String"
		resultType="demo.usercart.model.User">

		SELECT *
		FROM users
		WHERE username = #{username}

	</select>


	<!-- 判斷 username 是否存在 -->
	<select id="existsByUsername" parameterType="java.lang.String"
		resultType="boolean">

		SELECT COUNT(*) > 0
		FROM users
		WHERE username = #{username}

	</select>


	<!-- 判斷 email 是否存在 -->
	<select id="existsByEmail" parameterType="java.lang.String"
		resultType="boolean">

		SELECT COUNT(*) > 0
		FROM users
		WHERE email = #{email}

	</select>


	<!-- 新增會員 -->
	<insert id="insert" parameterType="demo.usercart.model.User"
		useGeneratedKeys="true" keyProperty="id">

		INSERT INTO users
		(username, password, name, email)

		VALUES
		(#{username}, #{password}, #{name}, #{email})

	</insert>


</mapper>